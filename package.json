{
  "name": "biome-anti-slop",
  "version": "0.3.0",
  "private": true,
  "description": "Opinionated Biome rules for rejecting low-evidence TypeScript patterns.",
  "type": "module",
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test && bun run check:skill && bun run check:skill-bundle && bun run check:discovery",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/*.test.ts",
    "test:rules": "bun test tests/rules.test.ts",
    "test:installer": "bun test tests/installer.test.ts",
    "sync:skill": "bun scripts/sync-skill.ts",
    "check:skill-bundle": "bun scripts/sync-skill.ts --check",
    "check:skill": "python3 scripts/quick_validate.py skills/biome-anti-slop",
    "check:discovery": "skills add . --list"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "skills": "1.5.23",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NorbertBodziony/biome-anti-slop.git"
  },
  "bugs": {
    "url": "https://github.com/NorbertBodziony/biome-anti-slop/issues"
  },
  "homepage": "https://github.com/NorbertBodziony/biome-anti-slop#readme",
  "keywords": [
    "agent-skills",
    "biome",
    "gritql",
    "linting",
    "typescript"
  ]
}
